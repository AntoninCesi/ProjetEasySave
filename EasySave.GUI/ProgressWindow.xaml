<Window x:Class="EasySave.GUI.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Backup in Progress" 
        Height="400" Width="700"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7F6"
        ResizeMode="NoResize">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,25">
            <TextBlock FontSize="24" FontWeight="ExtraBold" Foreground="DarkGreen">
                <Run Text="⚡ BACKUP IN PROGRESS"/>
            </TextBlock>
            <TextBlock Text="{Binding JobName, Mode=OneWay}" 
                       FontSize="14" 
                       Foreground="#95A5A6"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Progress Content -->
        <Border Grid.Row="1" 
                Background="White" 
                CornerRadius="10" 
                BorderBrush="#DCDDE1" 
                BorderThickness="1"
                Padding="25">
            <StackPanel>
                
                <!-- Progress Bar -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <ProgressBar Grid.Column="0"
                                 Value="{Binding ProgressPercentage, Mode=OneWay}"
                                 Maximum="100"
                                 Height="30"
                                 Background="#ECF0F1"
                                 Foreground="#3498DB"
                                 BorderThickness="0"/>
                    
                    <TextBlock Grid.Column="1"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#2C3E50"
                               VerticalAlignment="Center"
                               Margin="15,0,0,0">
                        <Run Text="{Binding ProgressPercentage, StringFormat='{}{0:F1}', Mode=OneWay}"/>
                        <Run Text="%"/>
                    </TextBlock>
                </Grid>

                <!-- Files Count -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0"
                               Text="📁 Files:"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#34495E"
                               Width="120"/>
                    
                    <TextBlock Grid.Column="1"
                               Text="{Binding FilesProgress, Mode=OneWay}"
                               FontSize="13"
                               Foreground="#7F8C8D"/>
                </Grid>

                <!-- Data Size -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0"
                               Text="💾 Data:"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#34495E"
                               Width="120"/>
                    
                    <TextBlock Grid.Column="1"
                               FontSize="13"
                               Foreground="#7F8C8D">
                        <Run Text="{Binding ProcessedSizeFormatted, Mode=OneWay}"/>
                        <Run Text=" / "/>
                        <Run Text="{Binding TotalSizeFormatted, Mode=OneWay}"/>
                    </TextBlock>
                </Grid>

                <!-- Transfer Speed -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0"
                               Text="⚡ Speed:"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#34495E"
                               Width="120"/>
                    
                    <TextBlock Grid.Column="1"
                               Text="{Binding TransferSpeed, Mode=OneWay}"
                               FontSize="13"
                               Foreground="#7F8C8D"/>
                </Grid>

                <!-- Time Remaining -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0"
                               Text="⏱️ Remaining:"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#34495E"
                               Width="120"/>
                    
                    <TextBlock Grid.Column="1"
                               Text="{Binding TimeRemaining, Mode=OneWay}"
                               FontSize="13"
                               Foreground="#7F8C8D"/>
                </Grid>

                <Separator Margin="0,10,0,15" Background="#ECF0F1"/>

                <!-- Current File -->
                <TextBlock Text="📄 Current file:"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#34495E"
                           Margin="0,0,0,8"/>
                
                <TextBlock Text="{Binding CurrentFile, Mode=OneWay}"
                           FontSize="11"
                           Foreground="#95A5A6"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding CurrentFile, Mode=OneWay}"/>

            </StackPanel>
        </Border>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="0,20,0,0">
            <Button Content="⏸ Pause"
                    Command="{Binding PauseCommand}"
                    Width="110"
                    Height="40"
                    Margin="5,0"
                    Background="#F39C12"
                    Foreground="White"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand" Click="Button_Click"/>

            <Button Content="▶️ Resume"
                    Command="{Binding ResumeCommand}"
                    Width="110"
                    Height="40"
                    Margin="5,0"
                    Background="#27AE60"
                    Foreground="White"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand"/>

            <Button Content="⏹️ Stop"
                    Command="{Binding StopCommand}"
                    Width="110"
                    Height="40"
                    Margin="5,0"
                    Background="#E74C3C"
                    Foreground="White"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
