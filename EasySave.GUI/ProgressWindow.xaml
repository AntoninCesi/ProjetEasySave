<Window x:Class="EasySave.GUI.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Backup in Progress"
        Height="400" Width="700"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7F6"
        ResizeMode="NoResize">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,25">
            <TextBlock x:Name="TxtBackupTitle" FontSize="24" FontWeight="ExtraBold" Foreground="#2C3E50"/>
            <TextBlock Text="{Binding JobName, Mode=OneWay}" FontSize="14" Foreground="#95A5A6" Margin="0,5,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="10"
                BorderBrush="#DCDDE1" BorderThickness="1" Padding="25">
            <StackPanel>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ProgressBar Grid.Column="0" Value="{Binding ProgressPercentage, Mode=OneWay}"
                                 Maximum="100" Height="30" Background="#ECF0F1"
                                 Foreground="#3498DB" BorderThickness="0"/>
                    <TextBlock Grid.Column="1" FontSize="18" FontWeight="Bold"
                               Foreground="#2C3E50" VerticalAlignment="Center" Margin="15,0,0,0">
                        <Run Text="{Binding ProgressPercentage, StringFormat='{}{0:F1}', Mode=OneWay}"/>
                        <Run Text="%"/>
                    </TextBlock>
                </Grid>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtFilesLabel" Grid.Column="0" FontSize="13" FontWeight="SemiBold" Foreground="#34495E" Width="130"/>
                    <TextBlock Grid.Column="1" Text="{Binding FilesProgress, Mode=OneWay}" FontSize="13" Foreground="#7F8C8D"/>
                </Grid>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtDataLabel" Grid.Column="0" FontSize="13" FontWeight="SemiBold" Foreground="#34495E" Width="130"/>
                    <TextBlock Grid.Column="1" FontSize="13" Foreground="#7F8C8D">
                        <Run Text="{Binding ProcessedSizeFormatted, Mode=OneWay}"/>
                        <Run Text=" / "/>
                        <Run Text="{Binding TotalSizeFormatted, Mode=OneWay}"/>
                    </TextBlock>
                </Grid>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtSpeedLabel" Grid.Column="0" FontSize="13" FontWeight="SemiBold" Foreground="#34495E" Width="130"/>
                    <TextBlock Grid.Column="1" Text="{Binding TransferSpeed, Mode=OneWay}" FontSize="13" Foreground="#7F8C8D"/>
                </Grid>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtRemainingLabel" Grid.Column="0" FontSize="13" FontWeight="SemiBold" Foreground="#34495E" Width="130"/>
                    <TextBlock Grid.Column="1" Text="{Binding TimeRemaining, Mode=OneWay}" FontSize="13" Foreground="#7F8C8D"/>
                </Grid>

                <Separator Margin="0,10,0,15" Background="#ECF0F1"/>

                <TextBlock x:Name="TxtCurrentFileLabel" FontSize="12" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding CurrentFile, Mode=OneWay}" FontSize="11" Foreground="#95A5A6"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentFile, Mode=OneWay}"/>

            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="BtnPause" Command="{Binding PauseCommand}"
                    Width="110" Height="40" Margin="5,0" Background="#F39C12" Foreground="White"
                    FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="Button_Click"/>
            <Button x:Name="BtnResume" Command="{Binding ResumeCommand}"
                    Width="110" Height="40" Margin="5,0" Background="#27AE60" Foreground="White"
                    FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
            <Button x:Name="BtnStop" Command="{Binding StopCommand}"
                    Width="110" Height="40" Margin="5,0" Background="#E74C3C" Foreground="White"
                    FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
