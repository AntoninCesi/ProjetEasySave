<Window x:Class="EasySave.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="EasySave - Management Dashboard" 
        Height="500" Width="850"
        WindowStartupLocation="CenterScreen" 
        Background="#F4F7F6">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="TxtTitle"
                               Text="EASYSAVE"
                               FontSize="24" 
                               FontWeight="ExtraBold" 
                               Foreground="#2C3E50"/>
                    <TextBlock x:Name="TxtSubtitle"
                               Text="Manage and monitor your backup jobs"
                               FontSize="14" 
                               Foreground="#95A5A6"/>
                </StackPanel>

                <StackPanel Grid.Column="1" 
                            Orientation="Horizontal" 
                            VerticalAlignment="Center">
                    <TextBlock x:Name="TxtLanguage"
                               Text="Language:"
                               VerticalAlignment="Center" 
                               Margin="0,0,10,0"
                               Foreground="#2C3E50"
                               FontWeight="SemiBold"/>
                    <Button Content="FR" 
                            Click="BtnFR_Click"
                            Width="60" 
                            Height="35" 
                            Margin="5,0"
                            Background="#3498DB" 
                            Foreground="White" 
                            BorderThickness="0"
                            Cursor="Hand"
                            FontWeight="Bold"/>
                    <Button Content="EN" 
                            Click="BtnEN_Click"
                            Width="60" 
                            Height="35"
                            Background="#E74C3C" 
                            Foreground="White" 
                            BorderThickness="0"
                            Cursor="Hand"
                            FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <Border Grid.Row="1" 
                CornerRadius="8" 
                Background="White" 
                BorderBrush="#DCDDE1" 
                BorderThickness="1">
            <DataGrid ItemsSource="{Binding BackupJobs}" 
                      SelectedItem="{Binding SelectedJob, Mode=TwoWay}"
                      AutoGenerateColumns="False" 
                      CanUserAddRows="False" 
                      BorderThickness="0"
                      Background="Transparent"
                      RowHeight="35"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F1F2F6" SelectionChanged="DataGrid_SelectionChanged">

                <DataGrid.Columns>
                    <!-- Colonne de sélection avec checkbox -->
                    <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" 
                                            Width="60">
                        <DataGridCheckBoxColumn.Header>
                            <TextBlock Text="Select" x:Name="ColSelectHeader"/>
                        </DataGridCheckBoxColumn.Header>
                    </DataGridCheckBoxColumn>
                    <DataGridTextColumn x:Name="ColJobName"
                                        Header="Job Name"
                                        Binding="{Binding name}" 
                                        Width="150"/>
                    <DataGridTextColumn x:Name="ColSourcePath"
                                        Header="Source Path"
                                        Binding="{Binding sourcePath}" 
                                        Width="*"/>
                    <DataGridTextColumn x:Name="ColDestinationPath"
                                        Header="Destination Path"
                                        Binding="{Binding destinationPath}" 
                                        Width="*"/>
                    <DataGridTextColumn x:Name="ColType"
                                        Header="Type"
                                        Binding="{Binding type}" 
                                        Width="100"/>
                    <DataGridTextColumn x:Name="ColState"
                                        Header="State"
                                        Binding="{Binding status.Status}" 
                                        Width="100"/>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="0,20,0,0">
            <Button x:Name="BtnSettings"
                    Content="⚙️ Settings" 
                    Command="{Binding OpenSettingsCommand}"
                    Width="120" 
                    Height="40" 
                    Margin="5" 
                    Cursor="Hand" 
                    Background="#95A5A6" 
                    Foreground="White" 
                    BorderThickness="0"/>
            <Button x:Name="BtnDeleteJob"
                    Content="🗑️ Delete Job"
                    Command="{Binding DeleteJobCommand}"
                    Width="120" 
                    Height="40" 
                    Margin="5" 
                    Cursor="Hand" 
                    Background="#E74C3C" 
                    Foreground="White" 
                    FontWeight="SemiBold" 
                    BorderThickness="0"/>
            <Button x:Name="BtnCreateJob"
                    Content="➕ Create Job"
                    Command="{Binding CreateJobCommand}"
                    Width="120" 
                    Height="40" 
                    Margin="5" 
                    Cursor="Hand" 
                    Background="#3498DB" 
                    Foreground="White" 
                    FontWeight="Bold" 
                    BorderThickness="0"/>
            <Button x:Name="BtnRunSelection"
                    Content="▶️ Run Selected"
                    Command="{Binding RunSelectionCommand}"
                    Width="160" 
                    Height="40" 
                    Margin="5" 
                    Cursor="Hand" 
                    Background="#2ECC71" 
                    Foreground="White" 
                    FontWeight="Bold" 
                    BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
