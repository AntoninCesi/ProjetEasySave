<Window x:Class="EasySave.GUI.CreateJobDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Backup Job" 
        Width="650"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="#F4F7F6"
        ResizeMode="NoResize">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,25">
            <TextBlock Text="{Binding Lang[CreateJobTitle]}" FontSize="26" FontWeight="ExtraBold" Foreground="#2C3E50"/>
            <TextBlock Text="{Binding Lang[CreateJobSubtitle]}" FontSize="13" Foreground="#95A5A6" Margin="0,5,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="10" BorderBrush="#DCDDE1" BorderThickness="1" Padding="25">
            <StackPanel>
                <TextBlock Text="{Binding Lang[JobNameLabel]}" FontSize="14" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,8"/>
                <TextBox Text="{Binding JobName, UpdateSourceTrigger=PropertyChanged}" Height="40" VerticalContentAlignment="Center" Margin="0,0,0,20" Padding="10,0"/>

                <TextBlock Text="{Binding Lang[SourceFolderLabel]}" FontSize="14" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding SourcePath}" IsReadOnly="True" Height="40" VerticalContentAlignment="Center" Background="#F8F9FA" Padding="10,0"/>
                    <Button Grid.Column="1" Content="{Binding Lang[Browse]}" Command="{Binding BrowseSourceCommand}" Width="100" Margin="10,0,0,0" Background="#3498DB" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                </Grid>

                <TextBlock Text="{Binding Lang[DestinationFolderLabel]}" FontSize="14" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding DestinationPath}" IsReadOnly="True" Height="40" VerticalContentAlignment="Center" Background="#F8F9FA" Padding="10,0"/>
                    <Button Grid.Column="1" Content="{Binding Lang[Browse]}" Command="{Binding BrowseDestinationCommand}" Width="100" Margin="10,0,0,0" Background="#3498DB" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                </Grid>

                <TextBlock Text="{Binding Lang[BackupTypeLabel]}" FontSize="14" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,8"/>
                <ComboBox ItemsSource="{Binding BackupTypeNames}" SelectedItem="{Binding SelectedType}" Height="40" VerticalContentAlignment="Center"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{Binding Lang[Cancel]}" Command="{Binding CancelCommand}" Width="120" Height="45" Margin="5,0" Background="#95A5A6" Foreground="White" Cursor="Hand" BorderThickness="0"/>
            <Button Content="{Binding Lang[CreateJob]}" Command="{Binding CreateCommand}" Width="120" Height="45" Margin="5,0" Background="#27AE60" Foreground="White" FontWeight="Bold" Cursor="Hand" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
