<Window x:Class="EasySave.GUI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Settings - EasySave"
        Height="720" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7F6"
        ResizeMode="NoResize">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,25">
            <TextBlock x:Name="TxtSettingsTitle" FontSize="26" FontWeight="ExtraBold" Foreground="#2C3E50"/>
            <TextBlock x:Name="TxtSettingsSubtitle" FontSize="13" Foreground="#95A5A6" Margin="0,5,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="10"
                BorderBrush="#DCDDE1" BorderThickness="1" Padding="25">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Language -->
                    <TextBlock x:Name="TxtLanguageLabel" FontSize="15" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,8"/>
                    <TextBlock x:Name="TxtLanguageHint" FontSize="11" Foreground="#7F8C8D" Margin="0,0,0,10"/>
                    <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                              Height="40" FontSize="13" Margin="0,0,0,25"/>
                    <Separator Margin="0,0,0,25" Background="#ECF0F1"/>

                    <!-- Log Format -->
                    <TextBlock x:Name="TxtLogFormatLabel" FontSize="15" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,8"/>
                    <TextBlock x:Name="TxtLogFormatHint" FontSize="11" Foreground="#7F8C8D" Margin="0,0,0,10"/>
                    <ComboBox ItemsSource="{Binding LogFormats}" SelectedItem="{Binding SelectedLogFormat}"
                              Height="40" FontSize="13" Margin="0,0,0,25"/>
                    <Separator Margin="0,0,0,25" Background="#ECF0F1"/>

                    <!-- Encryption Extensions -->
                    <TextBlock x:Name="TxtEncryptionLabel" FontSize="15" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,8"/>
                    <TextBlock x:Name="TxtEncryptionHint" FontSize="11" Foreground="#7F8C8D" Margin="0,0,0,12" TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{Binding EncryptionExtensionItems}" Margin="0,0,0,25">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="4" CornerRadius="6" BorderThickness="1.5" Cursor="Hand" Padding="10,6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="White"/>
                                            <Setter Property="BorderBrush" Value="#DCDDE1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                                    <Setter Property="Background" Value="#EBF5FB"/>
                                                    <Setter Property="BorderBrush" Value="#3498DB"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Extension}" FontSize="13" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#7F8C8D"/>
                                                    <Setter Property="FontWeight" Value="Normal"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                                            <Setter Property="Foreground" Value="#2980B9"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Separator Margin="0,0,0,25" Background="#ECF0F1"/>

                    <!-- Logs Storage -->
                    <TextBlock x:Name="TxtLogsStorageLabel" FontSize="15" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,8"/>
                    <TextBlock x:Name="TxtLogsStorageHint" FontSize="11" Foreground="#7F8C8D" Margin="0,0,0,10"/>
                    <StackPanel Margin="0,0,0,20">
                        <RadioButton x:Name="RadioLocal" GroupName="LogsStorageGroup"
                                     IsChecked="{Binding IsLocalStorageSelected}" FontSize="13" Margin="0,0,0,5"/>
                        <RadioButton x:Name="RadioExternal" GroupName="LogsStorageGroup"
                                     IsChecked="{Binding IsCloudStorageSelected}" FontSize="13"/>
                        <RadioButton x:Name="RadioBoth" GroupName="LogsStorageGroup"
                                     IsChecked="{Binding IsBothStorageSelected}" FontSize="13"/>
                    </StackPanel>
                    <Separator Margin="0,0,0,25" Background="#ECF0F1"/>

                    <!-- Business Software -->
                    <TextBlock x:Name="TxtBizLabel" FontSize="15" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,8"/>
                    <TextBlock x:Name="TxtBizHint" FontSize="11" Foreground="#7F8C8D" Margin="0,0,0,10" TextWrapping="Wrap"/>
                    <TextBox Text="{Binding BusinessSoftware, UpdateSourceTrigger=PropertyChanged}"
                             Height="40" FontSize="13" Padding="10,0" VerticalContentAlignment="Center" Margin="0,0,0,25"/>
                    <Separator Margin="0,0,0,25" Background="#ECF0F1"/>

                    <!-- Priority Extensions -->
                    <TextBlock x:Name="TxtPriorityLabel" FontSize="15" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,8"/>
                    <TextBlock x:Name="TxtPriorityHint" FontSize="11" Foreground="#7F8C8D" Margin="0,0,0,12" TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{Binding PriorityExtensionItems}" Margin="0,0,0,25">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="4" CornerRadius="6" BorderThickness="1.5" Cursor="Hand" Padding="10,6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="White"/>
                                            <Setter Property="BorderBrush" Value="#DCDDE1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                                    <Setter Property="Background" Value="#EAFAF1"/>
                                                    <Setter Property="BorderBrush" Value="#27AE60"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Extension}" FontSize="13" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#7F8C8D"/>
                                                    <Setter Property="FontWeight" Value="Normal"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                                            <Setter Property="Foreground" Value="#27AE60"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Separator Margin="0,0,0,25" Background="#ECF0F1"/>

                    <!-- Max Parallel File Size -->
                    <TextBlock x:Name="TxtMaxSizeLabel" FontSize="15" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,8"/>
                    <TextBlock x:Name="TxtMaxSizeHint" FontSize="11" Foreground="#7F8C8D" Margin="0,0,0,10" TextWrapping="Wrap"/>
                    <TextBox Text="{Binding MaxParallelFileSizeKo, UpdateSourceTrigger=PropertyChanged}"
                             Height="40" FontSize="13" Padding="10,0" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Action Buttons -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BtnReset" Grid.Column="1" Command="{Binding ResetCommand}"
                    Width="160" Height="45" Margin="5,0" Background="#E67E22" Foreground="White"
                    FontWeight="SemiBold" FontSize="13" BorderThickness="0" Cursor="Hand"/>

            <Button x:Name="BtnCancel" Grid.Column="2" Command="{Binding CancelCommand}"
                    Width="110" Height="45" Margin="5,0" Background="#95A5A6" Foreground="White"
                    FontWeight="SemiBold" FontSize="13" BorderThickness="0" Cursor="Hand"/>

            <Button x:Name="BtnSave" Grid.Column="3" Command="{Binding SaveCommand}"
                    Width="110" Height="45" Margin="5,0" Background="#27AE60" Foreground="White"
                    FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand"/>
        </Grid>
    </Grid>
</Window>
