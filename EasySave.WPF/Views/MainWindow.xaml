<Window x:Class="EasySave.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="EasySave v2.0 - Management Dashboard" Height="500" Width="850"
        WindowStartupLocation="CenterScreen" Background="#F4F7F6">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="EASYSAVE" FontSize="24" FontWeight="ExtraBold" Foreground="#2C3E50"/>
            <TextBlock Text="Manage and monitor your backup jobs" FontSize="14" Foreground="#95A5A6"/>
        </StackPanel>

        <Border Grid.Row="1" CornerRadius="8" Background="White" BorderBrush="#DCDDE1" BorderThickness="1">
            <DataGrid ItemsSource="{Binding BackupJobs}" 
                      AutoGenerateColumns="False" 
                      CanUserAddRows="False" 
                      BorderThickness="0"
                      Background="Transparent"
                      RowHeight="35"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F1F2F6">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Job Name" Binding="{Binding name}" Width="150"/>
                    <DataGridTextColumn Header="Source Path" Binding="{Binding sourcePath}" Width="*"/>
                    <DataGridTextColumn Header="Destination Path" Binding="{Binding destinationPath}" Width="*"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding type}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Settings" Width="100" Height="40" Margin="5" Cursor="Hand" Background="#95A5A6" Foreground="White" BorderThickness="0"/>
            <Button Content="Create New Job" Width="140" Height="40" Margin="5" Cursor="Hand" Background="#3498DB" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
            <Button Content="Run Selection" Width="140" Height="40" Margin="5" Cursor="Hand" Background="#2ECC71" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>